# Firebase client SDK config (not secret — see CLAUDE.md "Public-repo security constraint").
# Copy this file to .env.local and fill in with values from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — upload "unsigned" de fotos dos pets (sem chave secreta no client).
# cloud name fica no dashboard; upload preset é criado em Settings > Upload > Upload presets (Signing Mode: Unsigned).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Firebase App Check — reCAPTCHA v3. Site key: Firebase console > App Check >
# registrar o app web > provedor reCAPTCHA v3. Sem essa var o App Check fica
# desligado (dev/CI sem setup continuam funcionando).
VITE_RECAPTCHA_SITE_KEY=
# Só em dev: token de debug (App Check > Apps > menu do app > "Gerenciar tokens
# de depuração"). Nunca commitar; vai no .env.local.
VITE_APPCHECK_DEBUG_TOKEN=
