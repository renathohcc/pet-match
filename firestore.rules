rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(donorId) {
      return isSignedIn() && request.auth.uid == donorId;
    }

    // Admin único do site — pode excluir pets adotados (o dono do anúncio
    // perde essa permissão depois do "Adotado", ver rule de pets abaixo) e
    // remover avaliações comprovadamente abusivas após um recurso.
    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'vJwhGPjI6eYVyl7XAfMevNKfJHR2';
    }

    function hasValidPetShape(data) {
      return data.keys().hasAll(['name', 'species', 'size', 'sex', 'city', 'status', 'donorId', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.species in ['cão', 'gato']
        && data.size in ['Pequeno', 'Médio', 'Grande']
        && data.sex in ['Macho', 'Fêmea']
        && data.city is string && data.city.size() > 0
        && data.status in ['disponivel', 'em_processo', 'adotado']
        && data.donorId is string;
    }

    match /pets/{petId} {
      // Leitura pública mesmo pra pets em_processo/adotado: nada no doc é
      // sensível além do que já fica exposto nos disponíveis, e isso evita
      // permission-denied ao abrir um pet favoritado que mudou de status.
      allow read: if true;

      allow create: if isSignedIn()
        && hasValidPetShape(request.resource.data)
        && request.resource.data.donorId == request.auth.uid;

      allow update: if isOwner(resource.data.donorId)
        && hasValidPetShape(request.resource.data)
        && request.resource.data.donorId == resource.data.donorId;

      // Pet adotado não pode mais ser excluído pelo próprio doador — evita
      // apagar o histórico junto de avaliações que já existem sobre a
      // adoção. Só o admin do site pode remover nesse caso (ex: pedido de
      // exclusão de dados, spam, etc).
      allow delete: if isAdmin() || (isOwner(resource.data.donorId) && resource.data.status != 'adotado');
    }

    match /users/{userId} {
      // Leitura totalmente pública: a página /usuario/:uid (nome, foto, tipo
      // de tutor, avaliações) precisa funcionar até pra visitante deslogado,
      // já que reviews também são públicas. Nada aqui é mais sensível do que
      // o que já é exposto via contactName do pet.
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Registro de "cliquei em conversar no WhatsApp" — usado pelo doador pra
    // escolher quem foi o adotante na hora de marcar o pet como adotado.
    match /interests/{interestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Avaliação mútua doador<->adotante, só depois do pet marcado como
    // adotado e só entre o par real (donorId/adopterId do próprio pet).
    // Imutável depois de criada (sem update/delete) e pública (reforça
    // confiança de quem está decidindo contatar um doador).
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && (
          (request.resource.data.direction == 'donor_to_adopter'
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.donorId == request.auth.uid
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.adopterId == request.resource.data.toUserId)
          ||
          (request.resource.data.direction == 'adopter_to_donor'
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.adopterId == request.auth.uid
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.donorId == request.resource.data.toUserId)
        );

      allow update: if false;
      // Avaliação normalmente não é excluída (histórico), mas o admin pode
      // remover uma comprovadamente abusiva depois de analisar um recurso.
      allow delete: if isAdmin();
    }

    // Recurso: quem recebeu uma avaliação pode contestar ela (ex: calúnia,
    // avaliação sem adoção real). O comentário original fica oculto pro
    // público enquanto o recurso existe (a nota numérica continua contando,
    // só o texto livre é escondido) — resolução manual pelo admin por
    // enquanto (sem painel de moderação ainda).
    match /reviewDisputes/{reviewId} {
      // Leitura pública só pra saber "essa avaliação está em recurso" (pra
      // esconder o comentário de qualquer visitante) — o motivo do recurso
      // também fica visível, é a versão do lado avaliado sobre o ocorrido.
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.disputedBy == request.auth.uid
        && get(/databases/$(database)/documents/reviews/$(reviewId)).data.toUserId == request.auth.uid;

      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
