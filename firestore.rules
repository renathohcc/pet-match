rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(donorId) {
      return isSignedIn() && request.auth.uid == donorId;
    }

    // Admin único do site — pode excluir pets adotados (o dono do anúncio
    // perde essa permissão depois do "Adotado", ver rule de pets abaixo) e
    // remover avaliações comprovadamente abusivas após um recurso.
    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'vJwhGPjI6eYVyl7XAfMevNKfJHR2';
    }

    function petDonorId(petId) {
      return get(/databases/$(database)/documents/pets/$(petId)).data.donorId;
    }

    // Pesquisa pós-adoção embutida na review (campo `survey`) — perguntas
    // diferentes por direção, ver SURVEY_QUESTIONS em ReviewDialog.jsx.
    // Só garante que as chaves obrigatórias vieram preenchidas; o texto livre
    // (opcional) não entra aqui.
    function hasValidSurvey(direction, survey) {
      return (direction == 'donor_to_adopter' && survey.keys().hasAll(['facilitou', 'voltariaUsar']))
        || (direction == 'adopter_to_donor' && survey.keys().hasAll(['correspondeuAnuncio', 'jaTinhaPet', 'experiencia']));
    }

    function hasValidPetShape(data) {
      return data.keys().hasAll(['name', 'species', 'size', 'sex', 'city', 'status', 'donorId', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.species in ['cão', 'gato']
        && data.size in ['Pequeno', 'Médio', 'Grande']
        && data.sex in ['Macho', 'Fêmea']
        && data.city is string && data.city.size() > 0
        && data.status in ['disponivel', 'adotado']
        && data.donorId is string;
    }

    match /pets/{petId} {
      // Leitura pública mesmo pra pets em_processo/adotado: nada no doc é
      // sensível além do que já fica exposto nos disponíveis, e isso evita
      // permission-denied ao abrir um pet favoritado que mudou de status.
      allow read: if true;

      allow create: if isSignedIn()
        && hasValidPetShape(request.resource.data)
        && request.resource.data.donorId == request.auth.uid;

      allow update: if (isOwner(resource.data.donorId)
          && hasValidPetShape(request.resource.data)
          && request.resource.data.donorId == resource.data.donorId)
        // Autoatendimento de quem confirmou a adoção (ver `interests` abaixo):
        // sem backend, é o navegador da própria pessoa que precisa fazer esse
        // último write — restrito a UM tipo de mudança só (disponivel -> adotado
        // + adopterId == o próprio uid), e só depois de confirmar de verdade.
        || (isSignedIn()
          && resource.data.status != 'adotado'
          && request.resource.data.status == 'adotado'
          && request.resource.data.adopterId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adopterId'])
          && get(/databases/$(database)/documents/interests/$(petId + '_' + request.auth.uid)).data.status == 'confirmado');

      // Pet adotado não pode mais ser excluído pelo próprio doador — evita
      // apagar o histórico junto de avaliações que já existem sobre a
      // adoção. Só o admin do site pode remover nesse caso (ex: pedido de
      // exclusão de dados, spam, etc).
      allow delete: if isAdmin() || (isOwner(resource.data.donorId) && resource.data.status != 'adotado');
    }

    match /users/{userId} {
      // Leitura totalmente pública: a página /usuario/:uid (nome, foto, tipo
      // de tutor, avaliações) precisa funcionar até pra visitante deslogado,
      // já que reviews também são públicas. Nada aqui é mais sensível do que
      // o que já é exposto via contactName do pet.
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Manifestação de interesse num pet — precisa do aceite do doador antes
    // do contato (whatsapp) ser liberado (ver petContacts abaixo), e a
    // adoção só vira definitiva quando a PRÓPRIA pessoa escolhida confirma
    // (ver `confirmacao_pendente`/`confirmado` abaixo e a regra de `pets`).
    // `donorId` é denormalizado do pet na criação — evita `get()` extra na
    // leitura/atualização e viabiliza listar "tudo que eu recebi" com uma
    // query só, em vez de pet por pet.
    match /interests/{interestId} {
      // Só o próprio interessado (seu pedido) ou o doador do pet (todos os
      // pedidos do anúncio dele) podem ler — antes disso vazava pra
      // qualquer usuário logado quem se interessou por qual pet.
      // "Meu próprio pedido" é checado pelo id do doc (`${petId}_${uid}`),
      // não por `resource.data.userId` — o doc quase sempre AINDA NÃO
      // existe (primeira visita de quem nunca manifestou interesse), e
      // `resource` vem null nesse caso; acessar `resource.data` nessa hora
      // dá erro e nega a leitura (é o que travava o botão em "Carregando...").
      allow read: if isSignedIn()
        && (interestId.matches('^.*_' + request.auth.uid + '$')
          || (resource != null && resource.data.donorId == request.auth.uid));

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.donorId == petDonorId(request.resource.data.petId);

      // Só mexe no campo status — nunca petId/userId/donorId/message por
      // baixo do pedido original. Duas linhas de transição possíveis:
      // o doador conduz o "funil" normal (inclusive escolher alguém como
      // adotante, que só fica pendente de confirmação); só a PRÓPRIA pessoa
      // escolhida — e só a partir de "confirmacao_pendente" — pode confirmar
      // de vez (ninguém mais consegue setar "confirmado").
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (resource.data.donorId == request.auth.uid
            && request.resource.data.status in ['pendente', 'aceito', 'recusado', 'confirmacao_pendente'])
          ||
          (resource.data.userId == request.auth.uid
            && resource.data.status == 'confirmacao_pendente'
            && request.resource.data.status in ['aceito', 'confirmado'])
        );

      allow delete: if false;
    }

    // Contato (whatsapp) do doador de um pet — fora do doc público de
    // `pets` de propósito, pra não vazar o número pra quem não teve o
    // interesse aceito (o doc do pet é público, esse aqui não).
    match /petContacts/{petId} {
      allow read: if isSignedIn()
        && resource != null
        && (resource.data.donorId == request.auth.uid
          || get(/databases/$(database)/documents/interests/$(petId + '_' + request.auth.uid)).data.status in ['aceito', 'confirmacao_pendente', 'confirmado']);

      allow create, update: if isSignedIn()
        && request.resource.data.donorId == request.auth.uid
        && petDonorId(petId) == request.auth.uid;

      allow delete: if false;
    }

    // Avaliação mútua doador<->adotante, só depois do pet marcado como
    // adotado e só entre o par real (donorId/adopterId do próprio pet).
    // Imutável depois de criada (sem update/delete) e pública (reforça
    // confiança de quem está decidindo contatar um doador).
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && hasValidSurvey(request.resource.data.direction, request.resource.data.survey)
        && (
          (request.resource.data.direction == 'donor_to_adopter'
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.donorId == request.auth.uid
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.adopterId == request.resource.data.toUserId)
          ||
          (request.resource.data.direction == 'adopter_to_donor'
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.adopterId == request.auth.uid
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.donorId == request.resource.data.toUserId)
        );

      allow update: if false;
      // Avaliação normalmente não é excluída (histórico), mas o admin pode
      // remover uma comprovadamente abusiva depois de analisar um recurso.
      allow delete: if isAdmin();
    }

    // Recurso: quem recebeu uma avaliação pode contestar ela (ex: calúnia,
    // avaliação sem adoção real). O comentário original fica oculto pro
    // público enquanto o recurso existe (a nota numérica continua contando,
    // só o texto livre é escondido) — resolução manual pelo admin por
    // enquanto (sem painel de moderação ainda).
    match /reviewDisputes/{reviewId} {
      // Leitura pública só pra saber "essa avaliação está em recurso" (pra
      // esconder o comentário de qualquer visitante) — o motivo do recurso
      // também fica visível, é a versão do lado avaliado sobre o ocorrido.
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.disputedBy == request.auth.uid
        && get(/databases/$(database)/documents/reviews/$(reviewId)).data.toUserId == request.auth.uid;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // Denúncia de anúncio (link "Denunciar anúncio" no rodapé/página do pet).
    // Só leitura/exclusão pelo admin (moderação); qualquer usuário logado
    // pode criar, só sobre si mesmo (reportedBy == uid), sem poder editar
    // ou apagar depois de enviada.
    match /reports/{reportId} {
      allow read, delete: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow update: if false;
    }

    // Notificações no sino da Navbar — todas endereçadas a um `userId` só (o
    // destinatário lê/apaga a própria, nunca a de outra pessoa). As que
    // exigem uma ação de verdade (`review_reminder`, `interest_request`,
    // `adoption_confirm_request`) não somem ao simplesmente abrir/clicar —
    // só quando a ação é feita; as puramente informativas
    // (`interest_accepted`, `adoption_confirmed`) são dispensáveis.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && (
        // Lembrete de avaliação pendente: criado no momento em que o pet
        // vira "adotado" de vez — pelo doador (fluxo manual sem adotante
        // rastreado) OU pelo próprio adotante (fluxo normal, é o navegador
        // dele que faz esse último write, ver regra de `pets`).
        (request.resource.data.type == 'review_reminder'
          && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.status == 'adotado'
          && (petDonorId(request.resource.data.petId) == request.auth.uid
            || get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.adopterId == request.auth.uid)
          && (
            (request.resource.data.direction == 'donor_to_adopter'
              && request.resource.data.userId == petDonorId(request.resource.data.petId))
            ||
            (request.resource.data.direction == 'adopter_to_donor'
              && request.resource.data.userId == get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.adopterId)
          ))
        ||
        // Pedido de interesse: o próprio interessado avisa o doador do pet.
        (request.resource.data.type == 'interest_request'
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.userId == petDonorId(request.resource.data.petId))
        ||
        // Interesse aceito: só o doador do pet avisa quem foi aceito.
        (request.resource.data.type == 'interest_accepted'
          && petDonorId(request.resource.data.petId) == request.auth.uid)
        ||
        // Pedido de confirmação de adoção: só o doador, ao escolher alguém
        // (interesse aceito -> confirmacao_pendente) avisa a pessoa escolhida.
        (request.resource.data.type == 'adoption_confirm_request'
          && petDonorId(request.resource.data.petId) == request.auth.uid
          && request.resource.data.userId != request.auth.uid)
        ||
        // Adoção confirmada: só quem confirmou (o próprio adotante) avisa o doador.
        (request.resource.data.type == 'adoption_confirmed'
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.userId == petDonorId(request.resource.data.petId))
      );

      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
