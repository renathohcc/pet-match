rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(donorId) {
      return isSignedIn() && request.auth.uid == donorId;
    }

    // Admins do site — podem excluir pets adotados (o dono do anúncio perde
    // essa permissão depois do "Adotado", ver rule de pets abaixo) e remover
    // avaliações comprovadamente abusivas após um recurso.
    // Lista (não um único UID) pra ter redundância: perder uma conta não
    // pode significar perder toda a moderação. Manter em sincronia com
    // ADMIN_UIDS em src/lib/admin.js.
    function adminUids() {
      return [
        'vJwhGPjI6eYVyl7XAfMevNKfJHR2',
        'beq3RVcauLb9tMOyXFLm8OyTaUh1',
      ];
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid in adminUids();
    }

    function petDonorId(petId) {
      return get(/databases/$(database)/documents/pets/$(petId)).data.donorId;
    }

    // Rate limiting sem backend: a criação de pet/denúncia/interesse só passa
    // se, NO MESMO batch, o cliente tiver carimbado rateLimits/{uid} com a
    // hora atual — e a regra de rateLimits abaixo exige um intervalo mínimo
    // desde o último carimbo do mesmo tipo. (getAfter = estado pós-commit.)
    function rlAfter() {
      return getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data;
    }

    // Pesquisa pós-adoção embutida na review (campo `survey`) — perguntas
    // diferentes por direção, ver SURVEY_QUESTIONS em ReviewDialog.jsx.
    // Só garante que as chaves obrigatórias vieram preenchidas; o texto livre
    // (opcional) não entra aqui.
    function hasValidSurvey(direction, survey) {
      return (direction == 'donor_to_adopter' && survey.keys().hasAll(['facilitou', 'voltariaUsar']))
        || (direction == 'adopter_to_donor' && survey.keys().hasAll(['correspondeuAnuncio', 'jaTinhaPet', 'experiencia']));
    }

    // Doc de perfil é público (leitura por qualquer um) — então a escrita
    // precisa ser estritamente validada: só as chaves conhecidas, tipos
    // certos e tamanhos limitados. Sem isso, o dono do próprio doc podia
    // gravar qualquer campo/tamanho num doc mundialmente legível
    // (impersonação via displayName, hospedagem de blob, etc).
    function hasValidUserShape(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'tutorType', 'onboarded'])
        && data.keys().hasAll(['displayName', 'tutorType'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.tutorType in ['independente', 'ong']
        && (!data.keys().hasAny(['onboarded']) || data.onboarded is bool);
    }

    // Só URLs de imagem do nosso Cloudinary (ou vazio, quando o anúncio não
    // tem foto) — impede apontar `image`/`thumbs` pra domínio externo
    // (rastreamento, spoofing de preview).
    function isOwnImageUrl(url) {
      return url is string && (url == '' || url.matches('https://res[.]cloudinary[.]com/gmhrbocv/.*'));
    }

    function hasValidPetShape(data) {
      return data.keys().hasAll(['name', 'species', 'size', 'sex', 'city', 'status', 'donorId', 'createdAt',
          'age', 'breed', 'story', 'health', 'temperament', 'neighborhood', 'image', 'thumbs', 'contactName', 'contactType'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.species in ['cão', 'gato']
        && data.size in ['Pequeno', 'Médio', 'Grande']
        && data.sex in ['Macho', 'Fêmea']
        && data.city is string && data.city.size() > 0 && data.city.size() <= 80
        && data.status in ['disponivel', 'adotado']
        && data.donorId is string
        && data.age is string && data.age.size() <= 40
        && data.breed is string && data.breed.size() <= 60
        && data.story is string && data.story.size() <= 2000
        && data.health is list && data.health.size() <= 12
        && data.temperament is list && data.temperament.size() <= 12
        && data.neighborhood is string && data.neighborhood.size() > 0 && data.neighborhood.size() <= 80
        && data.contactName is string && data.contactName.size() > 0 && data.contactName.size() <= 60
        && data.contactType is string && data.contactType.size() <= 40
        && isOwnImageUrl(data.image)
        && data.thumbs is list && data.thumbs.size() <= 4;
    }

    match /pets/{petId} {
      // Leitura pública mesmo pra pets em_processo/adotado: nada no doc é
      // sensível além do que já fica exposto nos disponíveis, e isso evita
      // permission-denied ao abrir um pet favoritado que mudou de status.
      allow read: if true;

      allow create: if isSignedIn()
        && hasValidPetShape(request.resource.data)
        && request.resource.data.donorId == request.auth.uid
        // createdAt sempre = agora (não dá pra pré/pós-datar pra manipular
        // ordenação); adopterId nunca vem na criação (só via confirmação);
        // reportCount, se vier, começa em 0.
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(['adopterId'])
        && (!request.resource.data.keys().hasAny(['reportCount']) || request.resource.data.reportCount == 0)
        && rlAfter().petAt == request.time;

      allow update: if (isOwner(resource.data.donorId)
          && hasValidPetShape(request.resource.data)
          && request.resource.data.donorId == resource.data.donorId)
        // Autoatendimento de quem confirmou a adoção (ver `interests` abaixo):
        // sem backend, é o navegador da própria pessoa que precisa fazer esse
        // último write — restrito a UM tipo de mudança só (disponivel -> adotado
        // + adopterId == o próprio uid), e só depois de confirmar de verdade.
        || (isSignedIn()
          && resource.data.status != 'adotado'
          && request.resource.data.status == 'adotado'
          && request.resource.data.adopterId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adopterId'])
          && get(/databases/$(database)/documents/interests/$(petId + '_' + request.auth.uid)).data.status == 'confirmado')
        // Contador de denúncias distintas: qualquer usuário logado pode
        // incrementar em 1, e SÓ se houver (no mesmo batch) a denúncia dele
        // pra esse pet — id determinístico `${petId}__${uid}` garante 1 por
        // pessoa. A busca esconde pets com reportCount alto (pós-moderação).
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
          && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
          && existsAfter(/databases/$(database)/documents/reports/$(petId + '__' + request.auth.uid)))
        // Admin zera o contador ao restaurar um anúncio revisado.
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
          && request.resource.data.reportCount == 0);

      // Pet adotado não pode mais ser excluído pelo próprio doador — evita
      // apagar o histórico junto de avaliações que já existem sobre a
      // adoção. Só o admin do site pode remover nesse caso (ex: pedido de
      // exclusão de dados, spam, etc).
      allow delete: if isAdmin() || (isOwner(resource.data.donorId) && resource.data.status != 'adotado');
    }

    // Carimbos de "última ação" por usuário — base do rate limiting (ver
    // rlAfter() e as regras de create de pets/reports/interests). O cliente
    // só consegue gravar a hora ATUAL, e nunca antes do intervalo mínimo
    // desde o último carimbo do mesmo tipo.
    match /rateLimits/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['petAt', 'reportAt', 'interestAt']);

      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['petAt', 'reportAt', 'interestAt'])
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['petAt'])
            && request.resource.data.petAt == request.time
            && (!('petAt' in resource.data) || request.time > resource.data.petAt + duration.value(45, 's')))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportAt'])
            && request.resource.data.reportAt == request.time
            && (!('reportAt' in resource.data) || request.time > resource.data.reportAt + duration.value(20, 's')))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestAt'])
            && request.resource.data.interestAt == request.time
            && (!('interestAt' in resource.data) || request.time > resource.data.interestAt + duration.value(12, 's')))
        );
    }

    match /users/{userId} {
      // Leitura totalmente pública: a página /usuario/:uid (nome, foto, tipo
      // de tutor, avaliações) precisa funcionar até pra visitante deslogado,
      // já que reviews também são públicas. Nada aqui é mais sensível do que
      // o que já é exposto via contactName do pet.
      allow read: if true;

      // `write` dividido em create/update (nunca delete — apagar o próprio
      // doc quebra referências em pets/reviews). Ambos com shape validado.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && hasValidUserShape(request.resource.data);
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && hasValidUserShape(request.resource.data);
      allow delete: if false;
    }

    // Manifestação de interesse num pet — precisa do aceite do doador antes
    // do contato (whatsapp) ser liberado (ver petContacts abaixo), e a
    // adoção só vira definitiva quando a PRÓPRIA pessoa escolhida confirma
    // (ver `confirmacao_pendente`/`confirmado` abaixo e a regra de `pets`).
    // `donorId` é denormalizado do pet na criação — evita `get()` extra na
    // leitura/atualização e viabiliza listar "tudo que eu recebi" com uma
    // query só, em vez de pet por pet.
    match /interests/{interestId} {
      // Só o próprio interessado (seu pedido) ou o doador do pet (todos os
      // pedidos do anúncio dele) podem ler — antes disso vazava pra
      // qualquer usuário logado quem se interessou por qual pet.
      //
      // Precisa de DOIS jeitos de checar "é meu próprio pedido":
      // - `resource.data.userId == uid`: obrigatório pras QUERIES de lista
      //   (`listMyInterests`, `where('userId','==',uid)`) — o Firestore só
      //   libera uma query quando consegue provar a regra usando os MESMOS
      //   campos do `where()`; ele não entende que o regex no id do doc é
      //   "a mesma coisa" que o campo, então uma lista com só o regex abaixo
      //   falha inteira com permission-denied (não filtra, nega tudo).
      // - `interestId.matches(...)`: cobre o `getMyInterest` (get() num doc
      //   que quase sempre AINDA NÃO existe, primeira visita de quem nunca
      //   manifestou interesse — `resource` vem null nesse caso, e
      //   `resource.data.userId` explode; é o que travava o botão em
      //   "Carregando..." antes). Só serve pra get() de doc único, não ajuda
      //   em lista nenhuma, mas não atrapalha (list nunca bate nesse ramo).
      allow read: if isSignedIn()
        && (interestId.matches('^.*_' + request.auth.uid + '$')
          || (resource != null && (resource.data.donorId == request.auth.uid || resource.data.userId == request.auth.uid)));

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.donorId == petDonorId(request.resource.data.petId)
        && rlAfter().interestAt == request.time;

      // Só mexe no campo status — nunca petId/userId/donorId/message por
      // baixo do pedido original. Duas linhas de transição possíveis:
      // o doador conduz o "funil" normal (inclusive escolher alguém como
      // adotante, que só fica pendente de confirmação); só a PRÓPRIA pessoa
      // escolhida — e só a partir de "confirmacao_pendente" — pode confirmar
      // de vez (ninguém mais consegue setar "confirmado").
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (resource.data.donorId == request.auth.uid
            && request.resource.data.status in ['pendente', 'aceito', 'recusado', 'confirmacao_pendente'])
          ||
          (resource.data.userId == request.auth.uid
            && resource.data.status == 'confirmacao_pendente'
            && request.resource.data.status in ['aceito', 'confirmado'])
        );

      allow delete: if false;
    }

    // Contato (whatsapp) do doador de um pet — fora do doc público de
    // `pets` de propósito, pra não vazar o número pra quem não teve o
    // interesse aceito (o doc do pet é público, esse aqui não).
    match /petContacts/{petId} {
      allow read: if isSignedIn()
        && resource != null
        && (resource.data.donorId == request.auth.uid
          || get(/databases/$(database)/documents/interests/$(petId + '_' + request.auth.uid)).data.status in ['aceito', 'confirmacao_pendente', 'confirmado']);

      allow create, update: if isSignedIn()
        && request.resource.data.donorId == request.auth.uid
        && petDonorId(petId) == request.auth.uid
        && request.resource.data.keys().hasOnly(['whatsapp', 'donorId'])
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 8 && request.resource.data.whatsapp.size() <= 25;

      allow delete: if false;
    }

    // Avaliação mútua doador<->adotante, só depois do pet marcado como
    // adotado e só entre o par real (donorId/adopterId do próprio pet).
    // Imutável depois de criada (sem update/delete) e pública (reforça
    // confiança de quem está decidindo contatar um doador).
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && hasValidSurvey(request.resource.data.direction, request.resource.data.survey)
        && (
          (request.resource.data.direction == 'donor_to_adopter'
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.donorId == request.auth.uid
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.adopterId == request.resource.data.toUserId)
          ||
          (request.resource.data.direction == 'adopter_to_donor'
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.adopterId == request.auth.uid
            && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.donorId == request.resource.data.toUserId)
        );

      // Imutável, EXCETO o booleano `underDispute` — é como o público sabe
      // que deve esconder o comentário (sem precisar ler reviewDisputes, que
      // é privado). Só a pessoa avaliada liga (ao recorrer) e só o admin
      // desliga (ao rejeitar o recurso). Nota/comentário nunca mudam.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['underDispute'])
        && (
          (resource.data.toUserId == request.auth.uid && request.resource.data.underDispute == true)
          || (isAdmin() && request.resource.data.underDispute == false)
        );
      // Avaliação normalmente não é excluída (histórico), mas o admin pode
      // remover uma comprovadamente abusiva depois de analisar um recurso.
      allow delete: if isAdmin();
    }

    // Recurso: quem recebeu uma avaliação pode contestar ela (ex: calúnia,
    // avaliação sem adoção real). O comentário original fica oculto pro
    // público enquanto o recurso existe (a nota numérica continua contando,
    // só o texto livre é escondido) — resolução manual pelo admin por
    // enquanto (sem painel de moderação ainda).
    match /reviewDisputes/{reviewId} {
      // Leitura restrita: o motivo do recurso (versão do lado avaliado, texto
      // livre) não é do público. Só o admin e as duas pessoas envolvidas.
      // O público sabe que há recurso pelo booleano `underDispute` na review.
      allow read: if isSignedIn() && (
        isAdmin()
        || (resource != null && (resource.data.disputedBy == request.auth.uid
          || resource.data.fromUserId == request.auth.uid))
      );

      allow create: if isSignedIn()
        && request.resource.data.disputedBy == request.auth.uid
        && get(/databases/$(database)/documents/reviews/$(reviewId)).data.toUserId == request.auth.uid;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // Denúncia de anúncio (link "Denunciar anúncio" no rodapé/página do pet).
    // Só leitura/exclusão pelo admin (moderação); qualquer usuário logado
    // pode criar, só sobre si mesmo (reportedBy == uid), sem poder editar
    // ou apagar depois de enviada.
    match /reports/{reportId} {
      allow read, delete: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reason in ['fraude', 'animal_doente', 'anuncio_falso', 'conteudo_inadequado', 'outro']
        && request.resource.data.details is string && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'aberta'
        && rlAfter().reportAt == request.time;
      // Resolução = mudança de status (mantém histórico de moderação), nunca
      // apagar. Só o admin, e só esses campos.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt'])
        && request.resource.data.status in ['resolvida', 'descartada'];
    }

    // Notificações no sino da Navbar — todas endereçadas a um `userId` só (o
    // destinatário lê/apaga a própria, nunca a de outra pessoa). As que
    // exigem uma ação de verdade (`review_reminder`, `interest_request`,
    // `adoption_confirm_request`) não somem ao simplesmente abrir/clicar —
    // só quando a ação é feita; as puramente informativas
    // (`interest_accepted`, `adoption_confirmed`) são dispensáveis.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && (
        // Lembrete de avaliação pendente: criado no momento em que o pet
        // vira "adotado" de vez — pelo doador (fluxo manual sem adotante
        // rastreado) OU pelo próprio adotante (fluxo normal, é o navegador
        // dele que faz esse último write, ver regra de `pets`).
        (request.resource.data.type == 'review_reminder'
          && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.status == 'adotado'
          && (petDonorId(request.resource.data.petId) == request.auth.uid
            || get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.adopterId == request.auth.uid)
          && (
            (request.resource.data.direction == 'donor_to_adopter'
              && request.resource.data.userId == petDonorId(request.resource.data.petId))
            ||
            (request.resource.data.direction == 'adopter_to_donor'
              && request.resource.data.userId == get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.adopterId)
          ))
        ||
        // Pedido de interesse: o próprio interessado avisa o doador do pet.
        (request.resource.data.type == 'interest_request'
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.userId == petDonorId(request.resource.data.petId))
        ||
        // Interesse aceito: só o doador do pet avisa quem foi aceito.
        (request.resource.data.type == 'interest_accepted'
          && petDonorId(request.resource.data.petId) == request.auth.uid)
        ||
        // Pedido de confirmação de adoção: só o doador, ao escolher alguém
        // (interesse aceito -> confirmacao_pendente) avisa a pessoa escolhida.
        (request.resource.data.type == 'adoption_confirm_request'
          && petDonorId(request.resource.data.petId) == request.auth.uid
          && request.resource.data.userId != request.auth.uid)
        ||
        // Adoção confirmada: só quem confirmou (o próprio adotante) avisa o doador.
        (request.resource.data.type == 'adoption_confirmed'
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.userId == petDonorId(request.resource.data.petId))
      );

      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
